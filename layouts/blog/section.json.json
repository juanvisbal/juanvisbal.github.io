{
	"version": "https://jsonfeed.org/version/1",
	"title": {{ site.Params.blog.title | jsonify }},
	"icon": "{{ .Site.Params.author.avatar | absURL }}",
	"home_page_url": "{{ .Permalink }}",
	"feed_url": "{{ .Permalink }}feed.json",
	"items": [
		{{- $list := first 25 (where site.RegularPages "Layout" "post") -}}
		{{- $len := (len $list) -}}
		{{ range $index, $value := $list }}
			{
				{{ if .Params.guid -}}
				"id": "{{ .Params.guid }}",
				{{- else -}}
				"id": "{{ .Permalink }}",
				{{- end }}
				{{ if .Title -}}
				"title": {{ .Title | jsonify }},
				{{- end -}}
				{{- $s := (replace .Content "src=\"/blog/uploads/" (printf "src=\"%sblog/uploads/" site.BaseURL)) | jsonify -}}
				{{- $s := replace $s "\\u003c" "<" -}}
				{{- $s := replace $s "\\u003e" ">" -}}
				{{- $s := replace $s "\\u0026" "&" }}
				"content_html": {{ $s }},
				{{ if .Params.custom_summary }}"summary": {{ .Summary | plainify | htmlUnescape | jsonify }},{{ end }}
				"date_published": "{{ .Date.Format "2006-01-02T15:04:05-07:00" }}",
				"url": "{{ .Permalink }}"
				{{- with .Params.categories -}}
				,
				"tags": {{ . | jsonify }}
				{{- end }}
			}
			{{- if ne (add $index 1) $len -}},{{- end -}}
		{{ end }}
	]
}
