{
	"version": "https://jsonfeed.org/version/1",
	"title": {{ site.Params.blog.title | jsonify }},
	"icon": "{{ .Site.Params.author.avatar | absURL }}",
	"home_page_url": "{{ .Parent.Permalink }}",
	"feed_url": "{{ .Permalink }}index.json",
	"items": [
		{{- $list := slice -}}
		{{- range where site.RegularPages "Layout" "post" }}{{ if partial "blog/first-image.html" . }}{{ $list = $list | append . }}{{ end }}{{ end -}}
		{{- $len := (len $list) -}}
		{{ range $index, $value := $list }}
			{
				"id": "{{ .Permalink }}",
				"title": {{ .Title | jsonify }},
				{{- $s := .Content | jsonify -}}
				{{- $s := replace $s "\\u003c" "<" -}}
				{{- $s := replace $s "\\u003e" ">" -}}
				{{- $s := replace $s "\\u0026" "&" }}
				"content_html": {{ $s }},
				"date_published": "{{ .Date.Format "2006-01-02T15:04:05-07:00" }}",
				"url": "{{ .Permalink }}",
				"image": "{{ partial "blog/first-image.html" . | absURL }}"
			}
			{{- if ne (add $index 1) $len -}},{{- end -}}
		{{ end }}
	]
}
